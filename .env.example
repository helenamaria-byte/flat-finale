# Storage (pick one). Supabase is used first if both are set.
# Supabase: Project Settings -> API. Keep the service role key secret (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Or Upstash Redis: set automatically when you connect it in Vercel -> Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Gemini writes the plain-language summary for each option
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
